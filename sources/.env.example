# Adzuna credentials are secret. Search queries live in adzuna/config.yaml.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional path override; the default is sources/adzuna/config.yaml.
ADZUNA_CONFIG=

# Jooble credentials are secret. Query profiles live in jooble/config.yaml.
JOOBLE_API_KEY=
# Optional path override; the default is sources/jooble/config.yaml.
JOOBLE_CONFIG=

# Arbeitnow needs no credentials. Optional path override only.
ARBEITNOW_CONFIG=

# Himalayas needs no credentials. Search queries live in himalayas/config.yaml.
# Optional path override; the default is sources/himalayas/config.yaml.
HIMALAYAS_CONFIG=

# Jobicy needs no credentials. Query profiles live in jobicy/config.yaml.
# Optional path override; the default is sources/jobicy/config.yaml.
JOBICY_CONFIG=

# Planned collector (not implemented yet).
ASHBY_BOARDS=

# Optional path-list override. Use ; on Windows and : on macOS/Linux.
# Defaults to both authoritative files under registry/candidate/.
CANDIDATE_PROFILE_PATHS=

# Optional absolute path to the installed md-to-docx skill wrapper.
# By default it is discovered under CODEX_HOME/skills/md-to-docx/.
MD_TO_DOCX_SCRIPT=
